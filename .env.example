# Copy this file to .env and fill in your own key. .env is gitignored —
# never commit a real key.

# Free-tier key from https://console.groq.com/keys. Required by the
# server-side agent (src/agent/llm-client.js, Milestone B). The process
# fails at startup, loudly, if this is unset — see design.md D13/D14.
GROQ_API_KEY=

# Free-plan key from the AssemblyAI dashboard (API Keys page). Server-side
# only: the agent process exchanges it for short-lived streaming tokens and
# it never reaches the browser (design.md D19). Optional — without it, typed
# instructions still work and push-to-talk shows an error (design.md D25).
ASSEMBLYAI_API_KEY=

# Free tier from https://tavily.com (Overview page): 1,000 credits a month,
# 1 per search, no card required. Server-side only — never sent to the
# browser, never logged (design.md D38, same rule as the AssemblyAI key).
# Optional — without it, `search_web` reports `{ available: false }` and the
# agent says it cannot check, exactly as it does today.
TAVILY_API_KEY=

# --- Milestone F (deployment) — all optional locally ---
# Leave these unset for local development: src/config.js falls back to
# today's localhost values (design D40). Vite reads the VITE_-prefixed ones
# from this same file automatically at build/dev time; the agent process
# reads the bare ones via `--env-file=.env`.
#
# WS_URL=ws://[::1]:1234           # Node-side: the relay the agent connects to
# VITE_WS_URL=ws://[::1]:1234      # browser-side: the relay the page connects to
# AGENT_URL=http://localhost:3001  # Node-side: unused by the agent itself, kept for symmetry
# VITE_AGENT_URL=http://localhost:3001  # browser-side: base URL for /instruction, /cancel, /stt-token
# CORS_ORIGIN=http://localhost:5173     # Node-side: page origin the agent accepts requests from
